# Copy to ~/.config/commandcenter/grok.env (outside the repo) and edit.
# With the grok CLI installed and signed in (grok login), nothing is required.

# GROK_BACKEND=cli            # cli | api (default: cli if the grok command is found)
# GROK_BIN=~/.grok/bin/grok
# GROK_API_KEY=               # only for the api backend; never commit this
# GROK_MODEL=grok-4.7
# GROK_EFFORT=medium          # low | medium | high | xhigh
