# Copy to ~/.config/commandcenter/imsg.env (outside the repo) and edit.
# Values already set in the environment win over this file.

# Access is per client: run "imsg-mcp token add <label> -scopes read[,send]"
# for each agent. Tokens are stored hashed in imsg-clients.txt next to this file.
# IMSG_CLIENTS=~/.config/commandcenter/imsg-clients.txt

# Legacy: one full-access token (read + send). Prefer per-client tokens.
# IMSG_TOKEN=

# IMSG_ADDR=127.0.0.1:8765
# IMSG_BIN=/opt/homebrew/bin/imsg
# IMSG_DB=/path/to/chat.db.snapshot

# One-time-code filter: redact (default) | drop | off
# IMSG_OTP_FILTER=redact

# Sending: off unless this is 1 AND imsg-allowlist.txt lists someone.
# IMSG_ALLOW_SEND=1
# IMSG_SEND_MAX_PER_HOUR=10
# IMSG_SEND_DRY_RUN=1          # log what would be sent, send nothing
# IMSG_SEND_SERVICE=imessage   # imessage | sms | auto (passed to imsg send --service)
# IMSG_SEND_ALLOWLIST=~/.config/commandcenter/imsg-allowlist.txt
# IMSG_SEND_LOG=~/.config/commandcenter/logs/imsg-send.log
