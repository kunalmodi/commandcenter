# Copy to ~/.config/commandcenter/sitecheck.env (outside the repo).
# Everything here is optional; sitecheck works on any public site without it.

# PageSpeed Insights API key. Without one, the shared keyless quota is often used
# up and sitecheck falls back to local Lighthouse (lab data only, no real users).
# Get one in Google Cloud console: APIs & Services, enable "PageSpeed Insights
# API", then Credentials, Create credentials, API key (restrict it to that API).
PAGESPEED_API_KEY=

# Google Search Console, for your own sites: index status, queries, sitemaps.
# Pick ONE of these.
#
# a) Service account (recommended: no browser sign-in, never expires)
#    1. Google Cloud console: enable "Google Search Console API".
#    2. IAM & Admin, Service Accounts, Create. Then Keys, Add key, JSON.
#       Save it as ~/.config/commandcenter/gsc-service-account.json (chmod 600).
#    3. Search Console, Settings, Users and permissions, Add user: the service
#       account's email (…@….iam.gserviceaccount.com), permission Full.
#       Repeat for each site (or use one Domain property).
# GSC_SERVICE_ACCOUNT_FILE=/Users/YOU/.config/commandcenter/gsc-service-account.json
#
# b) Your own Google login
#    1. Google Cloud console: enable "Google Search Console API"; set up the OAuth
#       consent screen (External, add yourself as a test user, then "Publish app"
#       so the sign-in doesn't expire after 7 days).
#    2. Credentials, Create credentials, OAuth client ID, type "Desktop app",
#       then download the JSON.
#    3. Run: sitecheck auth google
# GOOGLE_OAUTH_CLIENT_FILE=/Users/YOU/.config/commandcenter/google-oauth-client.json

# Bing Webmaster Tools, for your own sites: backlinks and linking pages.
# bing.com/webmasters: add the site (Import from Google Search Console is
# quickest), then Settings (gear), API access, API key.
BING_WEBMASTER_API_KEY=

# Brave Search API, for any site: where the page ranks on Brave, the index
# Claude's web search uses. api-dashboard.search.brave.com: sign up, pick the
# free "Search" plan, then API Keys. sitecheck makes up to 3 queries per run.
BRAVE_SEARCH_API_KEY=
